{
  "name": "zaiken-app",
  "version": "1.0.0",
  "description": "Zaiken — Playnite/Overwolf-style gaming companion (library, overlay, AI coach)",
  "author": "Zaid Bilal Banat",
  "license": "UNLICENSED",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "test": "node test/smoke.test.js && node test/database.unit.test.js",
    "build:ts": "tsc && xcopy src\\renderer dist\\renderer /E /I /Y && xcopy src\\infrastructure\\database\\migrations dist\\infrastructure\\database\\migrations /E /I /Y",
    "lint": "node --check main.js && node --check src/main/database.js && node --check src/main/preload.js && node --check src/main/services/crash.js && node --check src/main/services/updater.js"
  },
  "build": {
    "appId": "com.zaiken.coach",
    "productName": "Zaiken",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "scripts/**/*"
    ],
    "afterPack": "./scripts/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "REPLACE_GITHUB_OWNER",
        "repo": "zaiken"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zaiken"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "electron": "30.5.1",
    "electron-builder": "24.13.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@sentry/electron": "5.3.0",
    "electron-updater": "6.3.9"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "jsonwebtoken": "^9.0.3",
    "keytar": "^7.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
