<file path="src/domain/services/RankCalculator.ts">
export function computeRank(input: {
  totalWins: number;
  totalKills: number;
  level: number;
}): string {
  const score = (input.totalWins || 0) * 3 + (input.totalKills || 0) * 0.5 + (input.level || 1) * 10;
  if (score >= 5000) return 'Master';
  if (score >= 2500) return 'Diamond';
  if (score >= 1000) return 'Platinum';
  if (score >= 400) return 'Gold';
  if (score >= 100) return 'Silver';
  return 'Bronze';
}

export function applyPlaytimeXp(
  profile: { xp: number; xpMax: number; level: number },
  minutes: number
): { xp: number; xpMax: number; level: number; xpGained: number } {
  const xpGained = Math.max(0, Math.round(minutes)) * 2;
  let xp = (profile.xp || 0) + xpGained;
  let xpMax = profile.xpMax || 1000;
  let level = profile.level || 1;
  while (xp >= xpMax) {
    xp -= xpMax;
    level += 1;
    xpMax = Math.round(xpMax * 1.25);
  }
  return { xp, xpMax, level, xpGained };
}
</file>

<file path="src/infrastructure/ai/providers/AnthropicProvider.ts">
import https from 'https';
import { URL } from 'url';
import type { AiProvider, AiChatRequest, AiChatResult } from './types';

export class AnthropicProvider implements AiProvider {
  name = 'anthropic';

  constructor(
    private apiKey: string,
    private opts?: { defaultModel?: string }
  ) {}

  async chat(req: AiChatRequest): Promise<AiChatResult> {
    const model = this.opts?.defaultModel || 'claude-sonnet-4-20250514';
    const body = JSON.stringify({
      model,
      max_tokens: 2048,
      temperature: req.temperature ?? 0.7,
      system: req.system || undefined,
      messages: [{ role: 'user', content: req.user }],
    });

    try {
      const data = await this.post('https://api.anthropic.com/v1/messages', body);
      const text = (data.content || []).map((c: any) => c.text || '').join('\n').trim();
      if (!text) return { ok: false, error: 'Empty response from Anthropic', provider: this.name };
      return { ok: true, text, model, provider: this.name };
    } catch (e: any) {
      return { ok: false, error: e?.message || String(e), provider: this.name };
    }
  }

  private post(urlStr: string, body: string): Promise<any> {
    return new Promise((resolve, reject) => {
      const u = new URL(urlStr);
      const req = https.request(
        {
          hostname: u.hostname,
          path: u.pathname,
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            'x-api-key': this.apiKey,
            'anthropic-version': '2023-06-01',
            'content-length': Buffer.byteLength(body),
          },
        },
        (res) => {
          const chunks: Buffer[] = [];
          res.on('data', (c) => chunks.push(c));
          res.on('end', () => {
            const text = Buffer.concat(chunks).toString('utf8');
            if (res.statusCode && res.statusCode >= 400) {
              return reject(new Error(`HTTP ${res.statusCode}: ${text.slice(0, 400)}`));
            }
            try {
              resolve(JSON.parse(text));
            } catch (e) {
              reject(e);
            }
          });
        }
      );
      req.on('error', reject);
      req.setTimeout(45000, () => {
        req.destroy();
        reject(new Error('Request timed out'));
      });
      req.write(body);
      req.end();
    });
  }
}
</file>

