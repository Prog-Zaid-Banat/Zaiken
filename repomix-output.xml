import { ipcMain } from "electron";
import { getGameRepository } from "./repositoryProvider";
import { SqliteSessionRepository } from "../../infrastructure/database/repositories/SqliteSessionRepository";
import { isTrustedSender } from "../windowRegistry";


const sessionRepository =
    new SqliteSessionRepository();


export function registerGameIpcHandlers() {


    ipcMain.handle(
        "zaiken:games:get-all",
        async () => {

            try {

                const gameRepository =
                    getGameRepository();


                const games =
                    await gameRepository.findAll();


                return {
                    success: true,
                    data: games
                };


            } catch (error: any) {

                console.error(
                    "[IPC Error] Failed to fetch games:",
                    error
                );


                return {
                    success: false,
                    error:
                        error.message ||
                        "Unknown database error"
                };

            }

        }
    );



    ipcMain.handle(
        "zaiken:games:save",
        async (_, gameData) => {

            try {

                const gameRepository =
                    getGameRepository();


                if (
                    !gameData ||
                    !gameData.name
                ) {

                    throw new Error(
                        "Game name is required"
                    );

                }


                const saved =
                    await gameRepository.add(
                        gameData
                    );


                return {
                    success: true,
                    data: saved
                };


            } catch (error: any) {

                console.error(
                    "[IPC Error] Failed to save game:",
                    error
                );


                return {
                    success: false,
                    error: error.message
                };

            }

        }
    );



    ipcMain.handle(
        "zaiken:games:update",
        async (_, id, patch) => {

            try {

                const gameRepository =
                    getGameRepository();


                if (!id) {

                    throw new Error(
                        "Game ID is required"
                    );

                }


                const updated =
                    await gameRepository.update(
                        id,
                        patch
                    );


                if (!updated) {

                    return {
                        success: false,
                        error: "Game not found"
                    };

                }


                return {
                    success: true,
                    data: updated
                };


            } catch (error: any) {

                console.error(
                    "[IPC Error] Failed to update game:",
                    error
                );


                return {
                    success: false,
                    error: error.message
                };

            }

        }
    );



    ipcMain.handle(
        "zaiken:games:delete",
        async (_, gameId) => {

            try {

                const gameRepository =
                    getGameRepository();


                if (!gameId) {

                    throw new Error(
                        "Game ID is required"
                    );

                }


                await gameRepository.delete(
                    gameId
                );


                return {
                    success: true
                };


            } catch (error: any) {

                console.error(
                    "[IPC Error] Failed to delete game:",
                    error
                );


                return {
                    success: false,
                    error: error.message
                };

            }

        }
    );


    ipcMain.handle(
        "db-add-session",
        async (event, gameId, minutes, stats) => {

            if (!isTrustedSender(event)) {
                return { success: false, error: "Unauthorized sender" };
            }

            if (typeof gameId !== "string" || !gameId.trim()) {
                return { success: false, error: "gameId is required" };
            }

            const m =
                Math.max(0, Math.round(Number(minutes) || 0));

            const s =
                stats && typeof stats === "object"
                    ? stats
                    : {};

            try {

                const startedAt =
                    new Date(
                        Date.now() - m * 60_000
                    ).toISOString();

                await sessionRepository.add({
                    gameId,
                    minutes: m,
                    kills: Number(s.kills) || 0,
                    deaths: Number(s.deaths) || 0,
                    wins: Number(s.wins) || 0,
                    losses: Number(s.losses) || 0,
                    matches: Number(s.matches) || 0,
                    startedAt,
                    endedAt: new Date().toISOString()
                });

                return { success: true };


            } catch (error: any) {

                return {
                    success: false,
                    error:
                        error?.message ||
                        "Failed to add session"
                };

            }

        }
    );

}
